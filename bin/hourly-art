#!/usr/bin/env bash
# Set a random public-domain artwork from the Met Museum or the Rijksmuseum
# as the wallpaper on the built-in screen only. Each artwork comes from one of
# four pools, with equal chance: the Met's European paintings, Japanese
# woodblock prints and European prints by selected artists, and the
# Rijksmuseum's paintings. The next artwork is fetched ahead, so the change
# itself takes about a second.
set -euo pipefail

# The output to decorate; see `kscreen-doctor -o` for names
OUTPUT=${HOURLY_ART_OUTPUT:-eDP-1}
API=https://collectionapi.metmuseum.org/public/collection/v1
RIJKS_SEARCH=https://data.rijksmuseum.nl/search/collection
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/hourly-art
POOLS=$CACHE/pools.tsv
mkdir -p "$CACHE"

# A catch-up run after boot or resume can start before plasmashell is up
for _ in {1..60}; do
  qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && break
  sleep 1
done
qdbus6 org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 \
  || { echo "plasmashell not on the session bus" >&2; exit 1; }

JAPANESE_ARTISTS=(Hokusai Hiroshige Kiyonaga Harunobu Kuniyoshi Kiyochika)
EUROPEAN_ARTISTS=(Dürer Rembrandt Piranesi Goya Whistler Canaletto)
# Japanese prints matching these are left out: the collection has a lot of
# shunga, and its tags don't reliably mark it
JAPANESE_EXCLUDE=(shunga erotic erotica lovers couple embrace "making love" pillow nude)
# Rijksmuseum paintings whose descriptions mention nudity are left out, and
# at pick time so are ones with these words in the title or these Iconclass
# subjects: the nude figure (31AA, 31AB) and classical mythology and history
# (92-98), where most of the collection's nudes are
RIJKS_EXCLUDE=(naakt naakte nude naked bloot)
RIJKS_TITLE_EXCLUDE='naakt|\bnudes?\b|naked|venus|dana[eë]|bath?sh?eba|susanna|leda|cleopatra|lucretia|nymph|nimf|bathers|baders|adam (and|en) eva?'
RIJKS_ICONCLASS_EXCLUDE='iconclass\.org/(31A[AB]|9[2-8])'

# Print the ID of every work found by a search with the given curl arguments,
# one per line, 500 a page (the API stops at 10000); pauses keep us under the
# Met's rate limits
search_ids() {
  local off=0 res total
  while :; do
    # Give up on a rebuild that drags on, so systemd's timeout never cuts it short
    (( SECONDS < 480 )) || return 1
    res=$(curl -sfG --connect-timeout 15 --max-time 60 "$API.1/search" "$@" -d limit=500 -d offset=$off) || return 1
    # A 200 with an HTML challenge or truncated JSON is a failure, not the end
    total=$(jq -e '.total | numbers' <<<"$res") || return 1
    jq -r '.objectIDs // [] | .[]' <<<"$res"
    off=$((off + 500)); sleep 1
    (( off < total && off < 10000 )) || return 0
  done
}

# Print "<pool>\t<id>\t<artist>" for every public-domain work with an image
# whose artist matches the name
search_artist() {
  local pool=$1 dept=$2 artist=$3
  search_ids --data-urlencode "q=$artist" -d departmentId="$dept" -d artistOrCulture=true \
    -d isPublicDomain=true -d hasImages=true | awk -v p="$pool" -v a="$artist" '{ print p "\t" $0 "\t" a }'
}

# Print the IDs of Asian Art works matching any of the exclusion terms
japanese_excluded() {
  local term
  for term in "${JAPANESE_EXCLUDE[@]}"; do
    search_ids --data-urlencode "q=$term" -d departmentId=6 || return 1
  done
}

# Print "rijks\t<id>\t" for every Rijksmuseum painting with an image; the
# search returns 100 a page, with a link to the next
rijks_paintings() {
  rijks_search "$RIJKS_SEARCH?type=painting&imageAvailable=true" | sed 's/.*/rijks\t&\t/'
}

# Print the ID of every Rijksmuseum work a search URL finds
rijks_search() {
  local url=$1 res
  while [[ -n $url ]]; do
    (( SECONDS < 480 )) || return 1
    res=$(curl -sf --connect-timeout 15 --max-time 60 "$url") || return 1
    # As with the Met, a reply that isn't the expected JSON is a failure
    jq -e '.orderedItems | arrays' <<<"$res" >/dev/null || return 1
    jq -r '.orderedItems[].id | sub(".*/"; "")' <<<"$res"
    url=$(jq -r '.next.id // empty' <<<"$res"); sleep 1
  done
}

build_pools() {
  local excluded japanese paintings
  excluded=$(japanese_excluded) || return 1
  curl -sf --connect-timeout 15 --max-time 60 "$API/objects?departmentIds=11" | jq -r '.objectIDs[] | "paintings\t\(.)\t"' || return 1
  sleep 1
  japanese=$(for a in "${JAPANESE_ARTISTS[@]}"; do search_artist japanese 6 "$a" || exit 1; done) || return 1
  awk -F'\t' 'NR == FNR { skip[$1]; next } !($2 in skip)' <(echo "$excluded") <(echo "$japanese")
  for a in "${EUROPEAN_ARTISTS[@]}"; do search_artist european 9 "$a" || return 1; done
  excluded=$(for term in "${RIJKS_EXCLUDE[@]}"; do
               rijks_search "$RIJKS_SEARCH?type=painting&description=$term" || exit 1
             done) || return 1
  paintings=$(rijks_paintings) || return 1
  awk -F'\t' 'NR == FNR { skip[$1]; next } !($2 in skip)' <(echo "$excluded") <(echo "$paintings")
}

# Locate the built-in display by its position (Plasma's screen numbering
# follows output priority, not KWin's order) and get its aspect ratio; while
# it's disabled (lid closed on an external screen) there's nothing to decorate
read -r enabled ox oy sw sh < <(kscreen-doctor -j | jq -r --arg o "$OUTPUT" \
  '.outputs[] | select(.name == $o and .connected)
   | "\(.enabled) \(.pos.x) \(.pos.y) \(.size.width) \(.size.height)"') || true
[[ -n ${enabled:-} ]] || { echo "output $OUTPUT not found; set HOURLY_ART_OUTPUT" >&2; exit 1; }
[[ $enabled == true ]] || { echo "output $OUTPUT is disabled; skipping" >&2; exit 0; }

# Refresh the pools weekly (-mtime +6: at least 7 days old); if the APIs are
# unreachable, keep the old list
refresh_pools() {
  # Rebuild a list that's a week old or lacks a pool (say, one added since),
  # but after a failed build wait a day before trying again
  if { [[ ! -s $POOLS ]] || [[ -n $(find "$POOLS" -mtime +6) ]] || ! complete "$POOLS"; } &&
     [[ -z $(find "$POOLS.failed" -mmin -1440 2>/dev/null) ]]; then
    # A build missing a whole pool (say, an empty reply) counts as failed
    if build_pools > "$POOLS.tmp" && complete "$POOLS.tmp"; then
      mv "$POOLS.tmp" "$POOLS"
      rm -f "$POOLS.failed"
    else
      rm -f "$POOLS.tmp"
      touch "$POOLS.failed"
    fi
  fi
  [[ -s $POOLS ]] || { echo "no artwork list available" >&2; return 1; }
}

complete() {
  awk -F'\t' '{ p[$1] } END {
    exit !(("paintings" in p) && ("japanese" in p) && ("european" in p) && ("rijks" in p)) }' "$1"
}

# Cut off the grey-scale calibration strip some scans have along the bottom,
# then print "<width> <height> <saturation> <fill mode> <bar colour>": crop to
# fill when that loses little of the work; otherwise fit it on bars in the
# median colour of its edges
analyse() {
  python3 - "$1" "$sw" "$sh" <<'PY' || echo "1 0 0 1 #000000"
import sys
from PIL import Image, ImageStat

def is_grey_scale(g):
    """A row through a grey-scale strip: dark to light in many flat steps."""
    if min(g) > 70 or max(g) < 170: return False
    edges = [i for i in range(len(g) - 2) if abs(g[i + 2] - g[i]) > 6]
    steps = sum(1 for k, i in enumerate(edges) if k == 0 or i - edges[k - 1] > 2)
    flat = sum(1 for i in range(1, len(g)) if abs(g[i] - g[i - 1]) <= 2) / len(g)
    return steps >= 8 and flat > 0.5

def strip_top(im):
    """Return the y where a grey-scale strip starts in the bottom third, or None."""
    W = 400
    sm = im.resize((W, max(1, round(im.height * W / im.width))))
    H = sm.height
    sat = sm.convert("HSV").getchannel("S").load(); px = sm.convert("L").load()
    hits = []
    for y in range(H * 2 // 3, H):
        start = 0
        for x in range(W + 1):
            # saturation is meaningless for near-black pixels; count them as grey
            if x == W or (sat[x, y] > 25 and px[x, y] > 60):
                if x - start >= W // 6 and is_grey_scale([px[i, y] for i in range(start, x)]):
                    hits.append(y); break
                start = x + 1
    # require a band of near-consecutive strip rows at least 1.5% of the height
    if not hits: return None
    bands, cur = [], [hits[0]]
    for y in hits[1:]:
        if y - cur[-1] <= 2: cur.append(y)
        else: bands.append(cur); cur = [y]
    bands.append(cur)
    band = max(bands, key=len)
    # cut a few rows above the first detected row, which can lag the strip edge
    return int(max(0, band[0] - 3) * im.height / H) if len(band) >= H * 0.015 else None

im = Image.open(sys.argv[1]).convert("RGB")
top = strip_top(im)
if top:
    im = im.crop((0, 0, im.width, top))
    im.save(sys.argv[1], quality=95)
w, h = im.size
small = im.resize((200, 200))
sat = ImageStat.Stat(small.convert("HSV")).mean[1]
r, R = w / h, int(sys.argv[2]) / int(sys.argv[3])
loss = 1 - min(r, R) / max(r, R)
# Bars appear top/bottom for wider-than-screen works, left/right otherwise
strips = ([(0, 0, 200, 4), (0, 196, 200, 200)] if r > R
          else [(0, 0, 4, 200), (196, 0, 200, 200)])
# get_flattened_data (Pillow 12.1+) replaces getdata, which goes in Pillow 14
flat = getattr(Image.Image, "get_flattened_data", None) or Image.Image.getdata
px = [p for box in strips for p in flat(small.crop(box))]
color = "#" + "".join(f"{sorted(c)[len(c) // 2]:02x}" for c in zip(*px))
print(w, h, int(sat), 2 if loss < 0.12 else 1, color)
PY
}

# Download a fresh artwork from the Met into $img, with a caption file next
# to it; fails if no suitable work turns up
fetch() {
  img=
  for try in $(seq 20); do
    # Stop after 10 minutes so the cached fallback runs before systemd's timeout
    (( SECONDS < 600 )) || break
    (( try == 1 )) || sleep 1
    fetch_one && return 0
  done
  img=
  return 1
}

fetch_one() {
  local pool id artist url name caption w h sat fill color
  pool=$(shuf -n1 -e paintings japanese european rijks)
  IFS=$'\t' read -r _ id artist < <(awk -F'\t' -v p="$pool" '$1 == p' "$POOLS" | shuf -n1) || return 1
  # Sets url, name (for the cache file) and caption, or fails if unsuitable
  if [[ $pool == rijks ]]; then rijks_object "$id" || return 1
  else met_object "$pool" "$id" "$artist" || return 1; fi
  # Leave alone a work that's on screen or already waiting
  img=$CACHE/art-$name.jpg
  [[ ! -f $img ]] || return 1
  curl -sf --connect-timeout 15 --max-time 120 "$url" -o "$img" || { rm -f "$img"; return 1; }
  # Skip portrait-oriented works (they look poor on a 16:10 screen),
  # low-resolution scans and black-and-white archival photos
  read -r w h sat fill color < <(analyse "$img")
  if (( w < 1920 || w < h || sat < 12 )); then rm -f "$img"; return 1; fi
  echo "$caption" > "${img%.jpg}.txt"
}

# "Title — artist (date)", from JSON with title, artist and date fields
CAPTION='"\(.title) — \((.artist // "") | if . == "" then "unknown" else . end)\((.date // "") | if . == "" then "" else " (\(.))" end)"'

met_object() {
  local pool=$1 id=$2 artist=$3 obj
  obj=$(curl -sf --connect-timeout 15 --max-time 30 "$API/objects/$id") || return 1
  # The search matches loosely, so check the artist; skip nudes in every pool
  # and, in the Japanese pool, anything whose title suggests shunga
  url=$(jq -r --arg a "$artist" --arg p "$pool" '
    select(.isPublicDomain and .primaryImage != "")
    | select($a == "" or (.artistDisplayName | contains($a)))
    | select(([.tags[]?.term] | any(test("Nude"))) or (.title | test("\\bnudes?\\b|naked"; "i")) | not)
    | select($p != "japanese"
        or (.title | test("embrac|lover|erotic|shunga|making love|couple|pillow"; "i") | not))
    | .primaryImage' <<<"$obj") || return 1
  [[ -n $url ]] || return 1
  name=$id
  caption=$(jq -r "{title, artist: .artistDisplayName, date: .objectDate} | $CAPTION" <<<"$obj")
}

# Rijksmuseum records are Linked Art: names and statements come in Dutch and
# English, marked with Getty AAT language IDs
AAT=http://vocab.getty.edu/aat
rijks_object() {
  local id=$1 obj shows subjects
  obj=$(curl -sfL --connect-timeout 15 --max-time 30 -H 'Accept: application/ld+json' \
    "https://id.rijksmuseum.nl/$id") || return 1
  # Only public-domain images (Public Domain Mark or CC0), and no nudes by title
  url=$(jq -r '
    [.subject_of[]?.digitally_carried_by[]?
     | select([.referred_to_by[]?.content] | any(test("creativecommons.org/publicdomain/")))
     | .access_point[]?.id | select(test("iiif"))][0] // empty' <<<"$obj") || return 1
  [[ -n $url ]] || return 1
  caption=$(jq -r --arg en "$AAT/300388277" '
    def english: (map(select([.language[]?.id] | index($en))) + .)[0].content // "";
    {title: ([.identified_by[]? | select(.type == "Name")] | english),
     artist: ([.produced_by.referred_to_by[]?] | english),
     date: ([.produced_by.timespan.identified_by[]?] | english)}
    | '"$CAPTION" <<<"$obj") || return 1
  grep -qiE "$RIJKS_TITLE_EXCLUDE" <<<"${caption% — *}" && return 1
  # The Iconclass subjects are on the separate depicted-image record
  shows=$(jq -r '.shows[0].id // empty' <<<"$obj")
  if [[ -n $shows ]]; then
    subjects=$(curl -sfL --connect-timeout 15 --max-time 30 -H 'Accept: application/ld+json' \
      "$shows" | jq -r '.represents_instance_of_type[]?.equivalent[]?.id') || return 1
    grep -qE "$RIJKS_ICONCLASS_EXCLUDE" <<<"$subjects" && return 1
  fi
  name=rijks-$id
}

# Each run shows the artwork the previous run fetched ahead, so the change
# lands right on the hour, then fetches the next one. Without one waiting
# (first run, or the last fetch failed), fetch it now.
NEXT=$CACHE/next
img=$(cat "$NEXT" 2>/dev/null || true)
rm -f "$NEXT"
if [[ ! -f ${img:-} || ! -f ${img%.jpg}.txt ]]; then
  img=
  if refresh_pools; then fetch || true; fi
fi

# No fresh work (offline, or every try rejected): show a random cached work,
# other than the one already on screen
if [[ ! -f ${img:-} ]]; then
  current=$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    var ds = desktops();
    for (var i = 0; i < ds.length; i++) {
      if (ds[i].screen < 0 || ds[i].screen >= screenCount) continue;
      var g = screenGeometry(ds[i].screen);
      if (g.x == $ox && g.y == $oy) {
        ds[i].currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
        print(ds[i].readConfig('Image'));
      }
    }" 2>/dev/null || true)
  img=$(for f in "$CACHE"/art-*.jpg; do
          if [[ -f ${f%.jpg}.txt && file://$f != "$current" ]]; then echo "$f"; fi
        done | shuf -n1)
  [[ -n $img ]] || { echo "no artwork found and nothing cached" >&2; exit 1; }
  echo "no new artwork found; using cached artwork" >&2
fi
read -r _ _ _ fill color < <(analyse "$img")

# Escape the path for a single-quoted JS string (backslashes first)
esc=${img//\\/\\\\}; esc=${esc//\'/\\\'}
cache_esc=${CACHE//\\/\\\\}; cache_esc=${cache_esc//\'/\\\'}
# Plasma ties desktops to screen numbers, not outputs, so this desktop may
# belong to another screen at other times (e.g. the external screen's when
# the laptop is used on its own). Remember what it showed before our first
# artwork, so hourly-art-fix-widgets can put that back when it moves on.
# Desktops left over from a disconnected screen are skipped.
result=$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
var ds = desktops();
for (var i = 0; i < ds.length; i++) {
  if (ds[i].screen < 0 || ds[i].screen >= screenCount) continue;
  var g = screenGeometry(ds[i].screen);
  if (g.x == $ox && g.y == $oy) {
    var plugin = ds[i].wallpaperPlugin;
    ds[i].currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
    var before = String(ds[i].readConfig('Image', ''));
    if (plugin != 'org.kde.image' || before.indexOf('file://$cache_esc/art-') != 0) {
      ds[i].currentConfigGroup = ['General'];
      ds[i].writeConfig('HourlyArtSavedPlugin', plugin);
      ds[i].writeConfig('HourlyArtSavedImage', before);
    }
    ds[i].wallpaperPlugin = 'org.kde.image';
    ds[i].currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
    ds[i].writeConfig('Image', 'file://$esc');
    ds[i].writeConfig('FillMode', $fill);
    ds[i].writeConfig('Blur', false);
    ds[i].writeConfig('Color', '$color');
    print('set');
  }
}") || { echo "$result" >&2; exit 1; }
[[ $result == *set* ]] || { echo "no Plasma desktop found for $OUTPUT" >&2; exit 1; }

cp "${img%.jpg}.txt" "$CACHE/current.txt"
# hourly-art-fix-widgets compares a desktop's wallpaper with this
echo "file://$img" > "$CACHE/current-image"
cat "$CACHE/current.txt"

# Keep a week of hourly downloads (with their captions) for offline use
ls -1t "$CACHE"/art-*.jpg | tail -n +169 | while read -r f; do rm -f "$f" "${f%.jpg}.txt"; done

# Fetch the next artwork now, ready for the next run
if refresh_pools && fetch; then
  echo "$img" > "$NEXT"
else
  echo "couldn't fetch the next artwork; the next run will try again" >&2
fi
