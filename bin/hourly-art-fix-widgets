#!/usr/bin/env bash
# Keep the caption, clock and artwork on the hourly-art screen only, with the
# widgets 32px from the sides and 16px from the bottom.
#
# Plasma ties desktops to screen numbers, which follow output priority, so
# the same desktop belongs to different screens as screens come and go (the
# external screen's desktop becomes the laptop's when it's used on its own).
# This adds the widgets to whichever desktop the hourly-art screen has now,
# and takes them and the artwork off other screens' desktops, restoring the
# wallpaper they had before. Plasma also moves widgets when a screen changes
# size (for example when the lid is closed with an external screen attached),
# and its scripting can't move them, so if they're out of place this briefly
# stops Plasma to edit the saved layout. Does nothing if all is in order.
set -euo pipefail

# The output to look after; see `kscreen-doctor -o` for names
OUTPUT=${HOURLY_ART_OUTPUT:-eDP-1}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/hourly-art
APPLETSRC=plasma-org.kde.plasma.desktop-appletsrc
DEFAULT_WALLPAPER=file:///usr/share/wallpapers/Next/

read -r ox oy < <(kscreen-doctor -j | jq -r --arg o "$OUTPUT" \
  '.outputs[] | select(.name == $o and .enabled) | "\(.pos.x) \(.pos.y)"') || true
on=${ox:+1}
# With the output off, match no desktop but still clear the other screens
[[ -n $on ]] || { ox=-1e9; oy=-1e9; }

cache_esc=${CACHE//\\/\\\\}; cache_esc=${cache_esc//\'/\\\'}
current=$(cat "$CACHE/current-image" 2>/dev/null || true)
current_esc=${current//\\/\\\\}; current_esc=${current_esc//\'/\\\'}
# Desktops left over from a disconnected screen are skipped. For the
# hourly-art screen's desktop, print "target <desktop id> <width> <height>
# <clock id> <clock x,y,w,h> <caption id> <caption x,y,w,h> <shows the
# current artwork>"
out=$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
var CLOCK = 'local.hourlyart.clock', CAPTION = 'local.hourlyart.caption';
// print() adds no newline
function say(s) { print(s + '\n'); }
function image(d) {
  d.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
  return d.wallpaperPlugin == 'org.kde.image' ? String(d.readConfig('Image', '')) : '';
}
function hasArt(d) {
  return image(d).indexOf('file://$cache_esc/art-') == 0;
}
function at(w) {
  var r = w.geometry;
  return w.id + ' ' + [r.x, r.y, r.width, r.height].map(Math.round).join(',');
}
var ds = desktops();
for (var i = 0; i < ds.length; i++) {
  var d = ds[i];
  if (d.screen < 0 || d.screen >= screenCount) continue;
  var g = screenGeometry(d.screen);
  var ws = d.widgets();
  if (g.x == $ox && g.y == $oy) {
    var found = {};
    for (var j = 0; j < ws.length; j++) found[ws[j].type] = ws[j];
    if (!found[CAPTION]) {
      found[CAPTION] = d.addWidget(CAPTION, 32, g.height - 16 - 96, 1008, 96);
      say('added the caption to desktop ' + d.id);
    }
    if (!found[CLOCK]) {
      found[CLOCK] = d.addWidget(CLOCK, g.width - 32 - 304, g.height - 16 - 224, 304, 224);
      say('added the clock to desktop ' + d.id);
    }
    say('target ' + d.id + ' ' + g.width + ' ' + g.height + ' '
      + at(found[CLOCK]) + ' ' + at(found[CAPTION]) + ' '
      + (image(d) == '$current_esc' ? 1 : 0));
    continue;
  }
  for (var j = 0; j < ws.length; j++) {
    if (ws[j].type == CLOCK || ws[j].type == CAPTION) {
      say('removed ' + ws[j].type + ' from desktop ' + d.id);
      ws[j].remove();
    }
  }
  if (hasArt(d)) {
    d.currentConfigGroup = ['General'];
    var plugin = String(d.readConfig('HourlyArtSavedPlugin', '')) || 'org.kde.image';
    var saved = String(d.readConfig('HourlyArtSavedImage', '')) || '$DEFAULT_WALLPAPER';
    d.wallpaperPlugin = plugin;
    d.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General'];
    d.writeConfig('Image', saved);
    say('restored the wallpaper of desktop ' + d.id);
  }
}") || { echo "$out" >&2; exit 1; }
grep -v '^target ' <<<"$out" | sed '/^$/d' || true

[[ -n $on ]] || { echo "output $OUTPUT is not enabled; nothing more to do"; exit 0; }
read -r _ cid sw sh clock clock_at caption caption_at art < <(grep '^target ' <<<"$out") || true
[[ -n ${cid:-} ]] || { echo "no Plasma desktop found for $OUTPUT" >&2; exit 1; }

# Set a new artwork once Plasma is settled if a desktop that just became the
# hourly-art screen's shows an older one than the caption names, or if the
# last change was before this hour (the hourly run skips while the screen is
# off, e.g. with the lid closed on an external screen)
new_art() {
  local changed hour
  changed=$(stat -c %Y "$CACHE/current-image" 2>/dev/null || echo 0)
  hour=$(date -d "$(date +'%F %H:00')" +%s)
  if (( !art || changed < hour )); then
    systemctl --user start --no-block hourly-art.service
  fi
}

# Same places and sizes as the installer uses
caption_want=32,$((sh - 16 - 96)),1008,96
clock_want=$((sw - 32 - 304)),$((sh - 16 - 224)),304,224
# Plasma snaps widgets to a 16px grid that starts where the panels end, so
# the exact spot may be out of reach; within half a grid step is in place
near() {
  local a b i
  IFS=, read -ra a <<<"$1"; IFS=, read -ra b <<<"$2"
  for i in 0 1 2 3; do
    (( ${a[i]} - ${b[i]} <= 8 && ${b[i]} - ${a[i]} <= 8 )) || return 1
  done
}
if near "$caption_at" "$caption_want" && near "$clock_at" "$clock_want"; then
  echo "Widgets on $OUTPUT are in place"
  new_art
  exit 0
fi
keys=("ItemGeometries-${sw}x$sh" ItemGeometriesHorizontal)
systemctl --user stop plasma-plasmashell
trap 'systemctl --user start plasma-plasmashell; new_art' EXIT

# Plasma saves positions relative to the part of the screen its panels leave
# free (a floating top panel takes 40px), but reports them relative to the
# screen. Work out that offset from where the caption is and where it's saved
# (only reliable once Plasma has stopped and written out its layout).
saved=$(kreadconfig6 --file "$APPLETSRC" --group Containments --group "$cid" --key "${keys[0]}" \
  | tr ';' '\n' | sed -n "s/^Applet-$caption://p")
dx=0 dy=0
if [[ -n $saved ]]; then
  IFS=, read -r sx sy _ <<<"$saved"
  IFS=, read -r lx ly _ <<<"$caption_at"
  dx=$((lx - ${sx%.*})) dy=$((ly - ${sy%.*}))
fi
shift_by() {
  IFS=, read -r x y w h <<<"$1"
  echo "$((x - dx)),$((y - dy)),$w,$h,0"
}
want=("Applet-$caption:$(shift_by "$caption_want")" "Applet-$clock:$(shift_by "$clock_want")")

# Replace our widgets' entries in a geometry list, keeping any others
merge() {
  { tr ';' '\n' <<<"$1" | grep -v -e "^Applet-$clock:" -e "^Applet-$caption:" -e '^$' || true
    printf '%s\n' "${want[@]}"; } | tr '\n' ';'
}

for key in "${keys[@]}"; do
  old=$(kreadconfig6 --file "$APPLETSRC" --group Containments --group "$cid" --key "$key")
  kwriteconfig6 --file "$APPLETSRC" --group Containments --group "$cid" --key "$key" "$(merge "$old")"
done
echo "Widgets on $OUTPUT moved back; Plasma is restarting"
